# FoodieHub POS — Environment Configuration Template
# Copy this file to '.env.local' to customize your installation without modifying code.

# -----------------------------------------------------------------------------
# 1. Master Administrator First-Boot Credentials
# If set, the POS will initialize with this Admin account automatically.
# If omitted or left empty, the POS displays a friendly "Initialize Master Admin"
# setup screen on first boot.
# -----------------------------------------------------------------------------
VITE_INITIAL_ADMIN_NAME=Admin
VITE_INITIAL_ADMIN_PIN=1234

# -----------------------------------------------------------------------------
# 2. Master Setup Token (Optional)
# If provided, creating the master admin will require this secret token.
# -----------------------------------------------------------------------------
VITE_INITIAL_ADMIN_TOKEN=foodiehub-master-secret-token
